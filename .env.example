# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser.
# Only the Supabase URL and publishable (anon) key may use that prefix.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# LLM provider (Phase 6). Server-only: never add a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=
